# ─── Vercel API Credentials ───────────────────────────────────────────────────
# Required to update environment variables and trigger redeployments via the API.

# Generate at: https://vercel.com/account/tokens
VERCEL_API_TOKEN=your_vercel_api_token_here

# Find in your Vercel project settings or run: npx vercel project ls
VERCEL_PROJECT_ID=prj_xxxxxxxxxxxxxxxxxxxxxxxx

# Only required if your project belongs to a Vercel team
# VERCEL_TEAM_ID=team_xxxxxxxxxxxxxxxxxxxxxxxx


# ─── SMTP Email Configuration ─────────────────────────────────────────────────
# These are set automatically when you submit the form in the app.
# You can also set them manually here for local development.

SMTP_HOST=mail.saturnia.io
SMTP_PORT=587
SMTP_USER=your-email@saturnia.io
SMTP_PASSWORD=your-email-password

EMAIL_FROM=noreply@saturnia.io
EMAIL_FROM_NAME=My App
